#!/usr/bin/env bash
set -euo pipefail

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------
# All output goes to a dedicated log file so handler runs and boot-time runs
# are easy to inspect later.
LOG="/var/log/firewalld-init.log"
exec >>"${LOG}" 2>&1
echo "=== $(date -Is) Applying managed firewalld policy ==="

# ------------------------------------------------------------
# Runtime values from Ansible variables
# ------------------------------------------------------------
PUBLIC_INTERFACE="{{ openvpn_public_interface }}"
VPN_INTERFACE="{{ openvpn_tunnel_interface }}"
LAB_INTERFACE="{{ lab_interface }}"

PUBLIC_ZONE="{{ host_firewall_public_zone }}"
VPN_ZONE="{{ host_firewall_vpn_zone }}"
LAB_ZONE="{{ host_firewall_lab_zone }}"
ADMIN_ZONE="{{ host_firewall_admin_zone }}"
VPN_TO_LAB_POLICY="{{ host_firewall_vpn_to_lab_policy }}"
VPN_TO_LAB_MASQUERADE="{{ host_firewall_vpn_to_lab_masquerade | bool | lower }}"
VPN_ALLOW_ICMP="{{ host_firewall_vpn_allow_icmp | bool | lower }}"

SUPERADMIN_FALLBACK_ENABLED="{{ superadmin_fallback_enabled | bool | lower }}"

PUBLIC_SERVICES=(
{% for service in host_firewall_public_services %}
  "{{ service }}"
{% endfor %}
)

PUBLIC_PORTS=(
{% for port in host_firewall_public_ports %}
  "{{ port }}"
{% endfor %}
)

VPN_SERVICES=(
{% for service in host_firewall_vpn_services %}
  "{{ service }}"
{% endfor %}
)

VPN_PORTS=(
{% for port in host_firewall_vpn_ports %}
  "{{ port }}"
{% endfor %}
)

LAB_SERVICES=(
{% for service in host_firewall_lab_services %}
  "{{ service }}"
{% endfor %}
)

LAB_PORTS=(
{% for port in host_firewall_lab_ports %}
  "{{ port }}"
{% endfor %}
)

SUPERADMIN_FALLBACK_CIDRS=(
{% for cidr in superadmin_fallback_cidrs %}
  "{{ cidr }}"
{% endfor %}
)

ADMIN_FALLBACK_PORTS=(
{% for port in host_firewall_admin_fallback_ports %}
  "{{ port }}"
{% endfor %}
)

RESTRICTED_TCP_PORTS=(
{% for port in host_firewall_restricted_tcp_ports %}
  "{{ port }}"
{% endfor %}
)

# ------------------------------------------------------------
# Helper functions
# ------------------------------------------------------------

# Create zone if it does not already exist.
ensure_zone() {
  local zone="$1"

  if ! firewall-cmd --permanent --get-zones | tr ' ' '\n' | grep -Fxq "${zone}"; then
    firewall-cmd --permanent --new-zone="${zone}"
  fi
}

# Bind an interface to a zone only when the interface exists.
# This prevents boot-time failures when tun0 is not yet present.
bind_interface_if_present() {
  local zone="$1"
  local iface="$2"

  if [[ -d "/sys/class/net/${iface}" ]]; then
    firewall-cmd \
      --permanent \
      --zone="${zone}" \
      --change-interface="${iface}"
  else
    echo "[!] Interface ${iface} not present yet; skipping zone binding for ${zone}"
  fi
}

# Remove all services currently present in a zone.
clear_zone_services() {
  local zone="$1"
  local service

  for service in $(
    firewall-cmd \
      --permanent \
      --zone="${zone}" \
      --list-services
  ); do
    firewall-cmd \
      --permanent \
      --zone="${zone}" \
      --remove-service="${service}"
  done
}

# Remove all open ports currently present in a zone.
clear_zone_ports() {
  local zone="$1"
  local port

  for port in $(
    firewall-cmd \
      --permanent \
      --zone="${zone}" \
      --list-ports
  ); do
    firewall-cmd \
      --permanent \
      --zone="${zone}" \
      --remove-port="${port}"
  done
}

# Remove all source CIDRs currently present in a zone.
clear_zone_sources() {
  local zone="$1"
  local source

  for source in $(
    firewall-cmd \
      --permanent \
      --zone="${zone}" \
      --list-sources
  ); do
    firewall-cmd \
      --permanent \
      --zone="${zone}" \
      --remove-source="${source}"
  done
}

# Remove all rich rules from a zone.
# This script treats rich rules in PUBLIC_ZONE as fully managed state.
clear_zone_rich_rules() {
  local zone="$1"
  local rule

  while IFS= read -r rule; do
    [[ -n "${rule}" ]] || continue
    firewall-cmd \
      --permanent \
      --zone="${zone}" \
      --remove-rich-rule="${rule}"
  done < <(
    firewall-cmd \
      --permanent \
      --zone="${zone}" \
      --list-rich-rules
  )
}

# Add each given service to a zone.
add_services() {
  local zone="$1"
  shift
  local service

  for service in "$@"; do
    firewall-cmd \
      --permanent \
      --zone="${zone}" \
      --add-service="${service}"
  done
}

# Add each given port to a zone.
add_ports() {
  local zone="$1"
  shift
  local port

  for port in "$@"; do
    firewall-cmd \
      --permanent \
      --zone="${zone}" \
      --add-port="${port}"
  done
}

# ------------------------------------------------------------
# Firewalld baseline
# ------------------------------------------------------------

# Ensure daemon is available before manipulating permanent config.
systemctl enable --now firewalld

# Ensure all zones used by this policy exist.
ensure_zone "${PUBLIC_ZONE}"
ensure_zone "${VPN_ZONE}"
ensure_zone "${LAB_ZONE}"
ensure_zone "${ADMIN_ZONE}"

# Keep default zone explicit and predictable.
firewall-cmd --set-default-zone="${PUBLIC_ZONE}"

# Bind interfaces to their intended zones.
# VPN bind is resilient when tun interface is not yet present.
bind_interface_if_present "${PUBLIC_ZONE}" "${PUBLIC_INTERFACE}"
bind_interface_if_present "${VPN_ZONE}" "${VPN_INTERFACE}"
bind_interface_if_present "${LAB_ZONE}" "${LAB_INTERFACE}"

# Deny by default in all managed zones.
firewall-cmd --permanent --zone="${PUBLIC_ZONE}" --set-target=DROP
firewall-cmd --permanent --zone="${VPN_ZONE}" --set-target=DROP
firewall-cmd --permanent --zone="${LAB_ZONE}" --set-target=DROP
firewall-cmd --permanent --zone="${ADMIN_ZONE}" --set-target=DROP

# ------------------------------------------------------------
# Zone reconciliation
# ------------------------------------------------------------

# Public zone: reset services and ports, then apply desired state.
clear_zone_services "${PUBLIC_ZONE}"
clear_zone_ports "${PUBLIC_ZONE}"
add_services "${PUBLIC_ZONE}" "${PUBLIC_SERVICES[@]}"
add_ports "${PUBLIC_ZONE}" "${PUBLIC_PORTS[@]}"

# VPN zone: only desired services and ports.
clear_zone_services "${VPN_ZONE}"
clear_zone_ports "${VPN_ZONE}"
add_services "${VPN_ZONE}" "${VPN_SERVICES[@]}"
add_ports "${VPN_ZONE}" "${VPN_PORTS[@]}"

# Optional ICMP allow so VPN clients can ping through tunnel while zone target
# remains DROP.
if [[ "${VPN_ALLOW_ICMP}" == "true" ]]; then
  firewall-cmd \
    --permanent \
    --zone="${VPN_ZONE}" \
    --query-rich-rule="rule protocol value='icmp' accept" >/dev/null 2>&1 || \
  firewall-cmd \
    --permanent \
    --zone="${VPN_ZONE}" \
    --add-rich-rule="rule protocol value='icmp' accept"

  firewall-cmd \
    --permanent \
    --zone="${VPN_ZONE}" \
    --query-rich-rule="rule family='ipv6' protocol value='ipv6-icmp' accept" >/dev/null 2>&1 || \
  firewall-cmd \
    --permanent \
    --zone="${VPN_ZONE}" \
    --add-rich-rule="rule family='ipv6' protocol value='ipv6-icmp' accept"
fi

# Lab zone: only desired services and ports.
clear_zone_services "${LAB_ZONE}"
clear_zone_ports "${LAB_ZONE}"
add_services "${LAB_ZONE}" "${LAB_SERVICES[@]}"
add_ports "${LAB_ZONE}" "${LAB_PORTS[@]}"

# Admin fallback zone: fully reconcile sources and service access.
clear_zone_services "${ADMIN_ZONE}"
clear_zone_ports "${ADMIN_ZONE}"
clear_zone_sources "${ADMIN_ZONE}"

if [[ "${SUPERADMIN_FALLBACK_ENABLED}" == "true" ]]; then
  firewall-cmd --permanent --zone="${ADMIN_ZONE}" --add-service=ssh
  add_ports "${ADMIN_ZONE}" "${ADMIN_FALLBACK_PORTS[@]}"

  for source in "${SUPERADMIN_FALLBACK_CIDRS[@]}"; do
    firewall-cmd --permanent --zone="${ADMIN_ZONE}" --add-source="${source}"
  done
fi

# ------------------------------------------------------------
# Restricted direct-access ports on public zone
# ------------------------------------------------------------
# All rich rules in PUBLIC_ZONE are reset first, then rebuilt from managed list.
clear_zone_rich_rules "${PUBLIC_ZONE}"

for port in "${RESTRICTED_TCP_PORTS[@]}"; do
  firewall-cmd \
    --permanent \
    --zone="${PUBLIC_ZONE}" \
    --add-rich-rule="rule family='ipv4' port port='${port}' protocol='tcp' reject"

  firewall-cmd \
    --permanent \
    --zone="${PUBLIC_ZONE}" \
    --add-rich-rule="rule family='ipv6' port port='${port}' protocol='tcp' reject"
done

# ------------------------------------------------------------
# Forwarding policy from VPN zone to LAB zone
# ------------------------------------------------------------

# Create policy once.
if ! firewall-cmd --permanent --get-policies | tr ' ' '\n' | grep -Fxq "${VPN_TO_LAB_POLICY}"; then
  firewall-cmd --permanent --new-policy="${VPN_TO_LAB_POLICY}"
fi

# Add zone attachments if they are not already present.
firewall-cmd \
  --permanent \
  --policy="${VPN_TO_LAB_POLICY}" \
  --add-ingress-zone="${VPN_ZONE}" 2>/dev/null || true

firewall-cmd \
  --permanent \
  --policy="${VPN_TO_LAB_POLICY}" \
  --add-egress-zone="${LAB_ZONE}" 2>/dev/null || true

# Permit traffic that matches policy direction.
firewall-cmd \
  --permanent \
  --policy="${VPN_TO_LAB_POLICY}" \
  --set-target=ACCEPT

# Optionally SNAT VPN client traffic toward LAB to avoid per-VM return route
# requirements for the OpenVPN subnet.
if [[ "${VPN_TO_LAB_MASQUERADE}" == "true" ]]; then
  firewall-cmd \
    --permanent \
    --policy="${VPN_TO_LAB_POLICY}" \
    --query-masquerade >/dev/null 2>&1 || \
  firewall-cmd \
    --permanent \
    --policy="${VPN_TO_LAB_POLICY}" \
    --add-masquerade
else
  firewall-cmd \
    --permanent \
    --policy="${VPN_TO_LAB_POLICY}" \
    --query-masquerade >/dev/null 2>&1 && \
  firewall-cmd \
    --permanent \
    --policy="${VPN_TO_LAB_POLICY}" \
    --remove-masquerade || true
fi

# Activate all permanent changes.
firewall-cmd --reload

echo "[+] Managed firewall policy applied"

# Final visibility for logs and troubleshooting.
firewall-cmd --zone="${PUBLIC_ZONE}" --list-all
firewall-cmd --zone="${VPN_ZONE}" --list-all
firewall-cmd --zone="${LAB_ZONE}" --list-all
firewall-cmd --zone="${ADMIN_ZONE}" --list-all
firewall-cmd --policy="${VPN_TO_LAB_POLICY}" --list-all
